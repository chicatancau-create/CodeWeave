{
  "name": "codeweave-web-client",
  "version": "0.1.0",
  "private": true,
  "description": "CodeWeave 网页端：登录、学习工作台、个人中心、复习与分析的浏览器界面",
  "author": "CodeWeave",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run audit:boundary && npm run contract:check && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run server:check",
    "preview": "vite preview",
    "contract:sync": "node scripts/sync-contract.mjs",
    "contract:check": "node scripts/sync-contract.mjs --check",
    "audit:boundary": "node scripts/audit-boundary.mjs",
    "server:check": "node --check server/service/server.mjs && node --check server/service/server/config.mjs",
    "server:start": "node server/service/server.mjs"
  },
  "dependencies": {
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.1",
    "vitest": "^4.1.11"
  }
}
