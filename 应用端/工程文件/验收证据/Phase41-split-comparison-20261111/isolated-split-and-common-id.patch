index 0000000..486e512
--- /dev/null
+++ "b/\345\272\224\347\224\250\347\253\257/\351\241\271\347\233\256/native/ui-qt/qml/components/IconButton.qml"
@@ -0,0 +1,47 @@
+import QtQuick
+import QtQuick.Controls.Basic
+
+Rectangle {
+    property QtObject ds
+    id: ibtn
+    property string glyph: ""
+    property string tip: ""
+    property bool active: false
+    property bool enabled: true
+    signal clicked
+    implicitWidth: 36
+    implicitHeight: 36
+    radius: 8
+    color: !ibtn.enabled ? Qt.rgba(220/255, 233/255, 251/255, 0.014)
+                         : (ibtn.active || ibHover.hovered ? ds.accentSoft : "transparent")
+    opacity: ibtn.enabled ? 1.0 : 0.5
+
+    // Smooth transition
+    Behavior on color {
+        ColorAnimation { duration: ds.durQuick; easing.type: ds.easingType }
+    }
+    Behavior on opacity {
+        NumberAnimation { duration: ds.durQuick; easing.type: Easing.Linear }
+    }
+
+    Text {
+        anchors.centerIn: parent
+        text: ibtn.glyph
+        color: !ibtn.enabled ? Qt.rgba(141/255, 155/255, 172/255, 0.4)
+                             : (ibtn.active || ibHover.hovered ? ds.accentHi : ds.muted)
+        font.family: ds.ui
+        font.pixelSize: 15
+
+        Behavior on color {
+            ColorAnimation { duration: ds.durQuick; easing.type: ds.easingType }
+        }
+    }
+    HoverHandler {
+        id: ibHover
+        enabled: ibtn.enabled
+        cursorShape: ibtn.enabled ? Qt.PointingHandCursor : Qt.ForbiddenCursor
+    }
+    TapHandler { enabled: ibtn.enabled; onTapped: ibtn.clicked() }
+    Accessible.role: Accessible.Button
+    Accessible.name: ibtn.tip !== "" ? ibtn.tip : ibtn.glyph
+}
diff --git "a/\345\272\224\347\224\250\347\253\257/\351\241\271\347\233\256/native/ui-qt/qml/components/NavItem.qml" "b/\345\272\224\347\224\250\347\253\257/\351\241\271\347\233\256/native/ui-qt/qml/components/NavItem.qml"
