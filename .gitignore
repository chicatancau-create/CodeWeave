# 依赖
node_modules/

# 构建与打包产物
build/
dist/
stage/
out/
artifacts/
coverage/
win-unpacked/

# 本机运行痕迹
.runtime-check-profile/
**/data/runtime/
.server.lock
.tmp-video/
*.log

# 环境变量与本机配置
.env
.env.*
*.local

# Android / Gradle
.gradle/
local.properties
.externalNativeBuild/
.cxx/
.kotlin/
captures/
*.jks
*.keystore
key.properties

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 交付产物与本机归档：不得进入公开仓库
*.exe
*.msi
*.msix
*.msixbundle
*.apk
*.aab
/备份区/
/工作区/*
!/工作区/工程审查待办.md
!/工作区/config/
/工作区/config/*
!/工作区/config/codeweave.config.example.json

# 原生模块的临时构建目录（另一个会话正在产生，名字不匹配 build/）
**/native/build*/
**/native/stage*/
**/native/*build*/

# Signing private keys must never be versioned. Public .cer files are allowed.
*.pfx
*.p12
*.key

# Local generated desktop delivery and build caches
/.electron-builder-cache/
/app-native-ascii/
/content/
/config/

# 代理/工具配置目录，不入库
.claude/

# Local Qt preview shortcut (machine-specific installed path)
/CodeWeave Qt 预览.lnk

# 固定三端布局：本机入口、SDK、构建与真实数据不进入 Git
/.local/
/应用端/开发环境/
/应用端/构建产物/
/*端/启动*端.lnk
/应用端/项目/workspace/
/应用端/项目/config/*.local.json
/网页端/项目/server/data/
*.tsbuildinfo
